---
import Layout from "./Layout.astro";
import Prose from "../components/Prose.astro"

const { frontmatter } = Astro.props;
---

<Layout>
  <h1 class="text-center">{frontmatter.title}</h1>
  <span class="text-center text-gray-600 italic">
    Written by Bálint Kiss &#x2022;
    Published on
    {new Date(frontmatter.published).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })}
    &#x2022;
    Updated on
    {new Date(frontmatter.updated).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })}
  </span>
  <Prose>
    <p>{frontmatter.summary}</p>
    <slot />
  </Prose>
</Layout>
