---
import Layout from "./Layout.astro";
import Prose from "../components/Prose.astro"

const { frontmatter } = Astro.props;
---

<Layout>
  <h1 class="text-center">{frontmatter.title}</h1>
  <span class="text-center text-gray-600 italic">
    Written by Bálint Kiss &#x2022;
    Published on
    {new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })}
  </span>
  <Prose>
    <style is:global>
      .prose a {
        @apply transition ease-in-out hover:text-[burlywood] duration-300;
      }
      /* Remove surrounding quotes from blockquote */
      .prose blockquote p::before,
      .prose blockquote p::after {
        content: none !important;
      }
      /* Remove backticks from inline code */
      .prose code::before,
      .prose code::after {
        content: none !important;
      }
    </style>
    <p>{frontmatter.summary}</p>
    <slot />
  </Prose>
</Layout>
