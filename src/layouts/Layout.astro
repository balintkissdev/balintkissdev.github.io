---
import Sidebar from "../components/Sidebar.jsx";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Bálint Kiss &ndash; Professional Software Engineer</title>
  </head>
  <body>
    <div>
      <!--
        Keep client directive to hydrate Sidebar, otherwise JavaScript won't load.
        Make hamburger clickable on tablet and mobile devices only.
      -->
      <Sidebar client:media="(max-width: 1024px)" />
      <div>
        <main class="pt-0 lg:pl-72 h-full flex items-center justify-center">
          <div class="p-8">
            <slot />
          </div>
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
