---
import Button from "./Button.astro";
import Badge from "./Badge.astro";
import GitHubButton from "react-github-btn";

import { Image } from 'astro:assets'

interface Props {
  title: string;
  url: string;
  badges?: string[];
  domain?: string;
  image?: string;
  githubStarRepo?: string;
  description: string;
}

const { title, url, badges, domain, image, githubStarRepo, description } = Astro.props;

function renderDescription(text: string): string {
  return text
    .trim()
    .split(/\n\n+/)
    .map(para => {
      const withLinks = para.replace(
        /\[([^\]]+)\]\(([^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noreferrer" class="underline">$1</a>'
      );
      return `<p>${withLinks}</p>`;
    })
    .join('\n');
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/side_project_preview/*');
const resolved = image ? (await images[`../assets/side_project_preview/${image}`]()).default : null;
---

<div class="p-4 border-solid rounded-lg border-2">
  <Button href={url} classNames="w-full rounded-lg">
    {resolved && <Image src={resolved} alt="demo image" class="mb-2 rounded-lg" />}
    <div class="flex flex-col items-center">
      <i class="p-4 fa-brands fa-github fa-xl"></i>
      <p>{title}</p>
    </div>
  </Button>
  {
    (domain || badges) && (
      <div>
        <p>
          {domain && <Badge bg="bg-[#702963]">{domain}</Badge>}
          {badges && badges.map((badge) => <Badge>{badge}</Badge>)}
        </p>
      </div>
    )
  }
  <div class="pt-4">
    {githubStarRepo && (
      <p class="mb-2">
        <GitHubButton
          href={`https://github.com/${githubStarRepo}`}
          data-size="large"
          data-show-count="true"
          aria-label={`Star ${githubStarRepo} on GitHub`}
          client:load
        >
          Star
        </GitHubButton>
      </p>
    )}
    <div set:html={renderDescription(description)} />
  </div>
</div>
