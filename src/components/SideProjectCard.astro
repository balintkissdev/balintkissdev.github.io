---
import Button from "./Button.astro";
import Badge from "./Badge.astro";
import GitHubButton from "react-github-btn";

import { Image } from 'astro:assets'

interface Props {
  title: string;
  repoUrl: string;
  demoUrl?: string;
  badges?: string[];
  domain?: string;
  image?: string;
  githubStarRepo?: string;
  description: string;
}

const { title, repoUrl, demoUrl, badges, domain, image, githubStarRepo, description } = Astro.props;
const resolvedDemoUrl = demoUrl ? `${import.meta.env.SITE}${demoUrl}` : undefined;

function renderDescription(text: string): string {
  return text
    .trim()
    .split(/\n\n+/)
    .map(para => {
      const withLinks = para.replace(
        /\[([^\]]+)\]\(([^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noreferrer" class="underline">$1</a>'
      );
      return `<p>${withLinks}</p>`;
    })
    .join('\n');
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/side_project_preview/*');
const resolved = image ? (await images[`../assets/side_project_preview/${image}`]()).default : null;
---

<div class="p-4 border-solid rounded-lg border-2">
  <a href={resolvedDemoUrl ?? repoUrl} target="_blank" rel="noreferrer" class="block mb-3 rounded-lg bg-[rgb(122,113,113)] p-2 hover:brightness-110 duration-300">
    {resolved && <Image src={resolved} alt="demo image" class="rounded-lg mb-2" />}
    <p class="text-center text-lg font-bold text-[whitesmoke]">{title}</p>
  </a>
  <div class="flex gap-2 mb-1">
    <Button href={repoUrl} classNames="flex-1 rounded-lg">
      <div class="flex items-center justify-center gap-2">
        <i class="fa-brands fa-github fa-lg"></i>
        <span>GitHub</span>
      </div>
    </Button>
    {resolvedDemoUrl && (
      <Button href={resolvedDemoUrl} classNames="flex-1 rounded-lg">
        <div class="flex items-center justify-center gap-2">
          <i class="fa-solid fa-play fa-lg"></i>
          <span>Live Demo</span>
        </div>
      </Button>
    )}
  </div>
  {
    (domain || badges) && (
      <div>
        <p>
          {domain && <Badge bg="bg-[#702963]">{domain}</Badge>}
          {badges && badges.map((badge) => <Badge>{badge}</Badge>)}
        </p>
      </div>
    )
  }
  <div class="pt-4">
    {githubStarRepo && (
      <p class="mb-2">
        <GitHubButton
          href={`https://github.com/${githubStarRepo}`}
          data-size="large"
          data-show-count="true"
          aria-label={`Star ${githubStarRepo} on GitHub`}
          client:load
        >
          Star
        </GitHubButton>
      </p>
    )}
    <div set:html={renderDescription(description)} />
  </div>
</div>
