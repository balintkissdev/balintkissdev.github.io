---
import ResumeSection from "./ResumeSection.astro";
import Button from "./Button.astro";
import TechSkillRow from "./TechSkillRow.astro";
---

<ResumeSection id="skills" title="Skills">
  <div class="mb-3">
    <h3>Technical skills</h3>
    <div class="flex flex-col divide-y">
      <TechSkillRow
        title="Programming languages"
        skills={["C++", "Go", "Rust", "Python", "Bash"]}
      />
      <TechSkillRow
        title="C++-related technologies"
        skills={[
          "CMake",
          "Make",
          "Clang Tooling",
          "Qt",
          "Boost",
          "Google Test",
          "Google Mock",
        ]}
      />
      <TechSkillRow
        title="Graphics"
        skills={["OpenGL", "WebGL"]}
      />
      <TechSkillRow
        title="Backend"
        skills={["REST", "RabbitMQ", "MQTT", "NATS", "OpenAPI", "gRPC"]}
      />
      <TechSkillRow
        title="Infra"
        skills={["Microsoft Azure", "Docker"]}
      />
      <TechSkillRow
        title="Frontend/Web development"
        skills={["React", "Tailwind CSS", "WebAssembly"]}
      />
      <TechSkillRow
        title="Database systems"
        skills={["PostgreSQL", "MongoDB"]}
      />
      <TechSkillRow
        title="Operating systems"
        skills={[
          "Arch Linux",
          "Fedora",
          "Red Hat",
          "Ubuntu",
          "Debian",
          "Microsoft Windows",
          "Solaris",
        ]}
      />
      <TechSkillRow
        title="Version control"
        skills={["Git", "Perforce"]}
      />
      <TechSkillRow
        title="Other"
        skills={[
          "Design patterns",
          "Anti-patterns",
          "Agile methodologies (Scrum, SAFE)",
          "Test automation",
          "TDD",
          "BDD",
          "CI/CD",
          "UML",
          "API and library programming",
          "Functional programming",
        ]}
      />
    </div>
  </div>
  <div class="mb-4">
    <h3 class="mb-4">Certifications</h3>
    <Button
      href="http://scr.istqb.org/?name=B%C3%A1lint+Kiss&number=&orderBy=relevancy&orderDirection=&dateStart=2018-06-29&dateEnd=2018-06-29&expiryStart=&expiryEnd=&certificationBody=23&examProvider=&certificationLevel=1&country=101&resultsPerPage=10"
    >
      ISTQB Certified Tester Foundation Level, International Software Testing
      Qualifications Board
    </Button>
  </div>
  <div class="mb-2">
    <h3>Soft skills</h3>
    <ul class="ml-4 list-disc list-inside">
      <li>Growth mindset</li>
      <li>Conducting interviews, mentoring, knowledge sharing</li>
      <li>Interest for new technologies, continous self-education</li>
      <li>Presenting to customers</li>
    </ul>
  </div>
</ResumeSection>
