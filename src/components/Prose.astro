---
---
<div
  class="prose
         prose-h1:font-bold
         prose-h1:text-xl

         prose-a:text-[rgb(122,113,113)]

         prose-p:mt-8
         prose-p:text-justify

         prose-pre:max-w-80
         prose-pre:sm:max-w-lg
         prose-pre:md:max-w-none
         prose-pre:rounded-lg

         prose-blockquote:text-gray-600

         prose-code:font-mono
  ">
  <style is:global>
    /* HACK: Duplication of link-hover style because processed separately from global.css */
    .prose a {
      @apply transition ease-in-out duration-300
    }
    .prose a:hover {
      @apply text-[burlywood]
    }
    /* Remove surrounding quotes from blockquote */
    .prose blockquote p::before,
    .prose blockquote p::after {
      content: none !important;
    }
    /* Remove backticks from inline code */
    .prose code::before,
    .prose code::after {
      content: none !important;
    }
  </style>
  <slot />
</div>
