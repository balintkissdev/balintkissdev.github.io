---
import ResumeSection from "./ResumeSection.astro";
import SideProjectCard from "./SideProjectCard.astro";

import GitHubButton from "react-github-btn";
---

<ResumeSection id="projects" title="Check out my projects">
  <div class="flex flex-row flex-wrap justify-center lg:justify-start gap-8">
    <SideProjectCard
      title="Networked client-server multiplayer architecture demo written in Rust"
      url="https://github.com/balintkissdev/multiplayer-game-demo-rust"
      domain="Network"
      badges={["Rust", "Tokio", "UDP", "OpenGL"]}
    >
      <p>
        A technical demonstration showcasing UDP socket programming, Tokio asynchronous runtime usage, and client-server game architecture in Rust. Features real-time synchronization of 2D movement between local and remote players.
      </p>
    </SideProjectCard>

    <SideProjectCard
      title="Real-time Rust 3D renderer"
      url="https://github.com/balintkissdev/3d-renderer-rust"
      domain="Graphics"
      badges={["Rust", "OpenGL", "WebGL", "WebAssembly"]}
    >
      <p>
        A hardware-accelerated 3D renderer written in Rust. Runs using OpenGL 4 as graphics API on desktop and WebGL2 on WebAssembly.
      </p>
      <p>
        {" "}
        <a
          href="https://balintkissdev.github.io/3d-renderer-rust"
          target="_blank"
          rel="noreferrer"
          class="underline"
        >
          Desktop browser-playable live demo
        </a>{" "}
         is compiled to WebAssembly using Emscripten.
      </p>
    </SideProjectCard>

    <SideProjectCard
      title="Real-time C++ 3D renderer"
      url="https://github.com/balintkissdev/3d-renderer-cpp"
      domain="Graphics"
      badges={["C++", "OpenGL", "WebGL", "WebAssembly", "Emscripten"]}
    >
      <p>
        A hardware-accelerated 3D renderer written in C++. Runs using OpenGL 4.6 or 3.3 as graphics API on desktop and WebGL2 in web browsers.
      </p>
      <p>
        {" "}
        <a
          href="https://balintkissdev.github.io/3d-renderer-cpp"
          target="_blank"
          rel="noreferrer"
          class="underline"
        >
          Desktop browser-playable live demo
        </a>{" "}
         is compiled to WebAssembly using Emscripten.
      </p>
    </SideProjectCard>

    <SideProjectCard
      title="Raycasting pseudo-3D graphics engine"
      url="https://github.com/balintkissdev/raycaster-engine"
      domain="Graphics"
      badges={["C++", "SDL2", "WebAssembly", "Emscripten"]}
    >
      <p>
        Retro 3D graphics engine demo inspired by techniques used in Wolfenstein 3D.
        Uses vector math and CPU-based software rendering to turn 2D maps into
        3D space, includes double-buffering and texture mapping.
      </p>
      <p>
        {" "}
        <a
          href="https://balintkissdev.github.io/raycaster-engine/"
          target="_blank"
          rel="noreferrer"
          class="underline"
        >
          Desktop browser-playable live demo
        </a>{" "}
         is compiled to WebAssembly using Emscripten.
      </p>
    </SideProjectCard>

    <SideProjectCard
      title="Awesome DOS"
      url="https://github.com/balintkissdev/awesome-dos#readme"
    >
      <p>
        <GitHubButton
          href="https://github.com/balintkissdev/awesome-dos"
          data-size="large"
          data-show-count="true"
          aria-label="Star balintkissdev/awesome-dos on GitHub"
          client:load
        >
          Star
        </GitHubButton>
      </p>
      <p>
        Curated list of references for development of DOS applications and
        learning about the system itself. The goal of this list is to collect
        information and act as a starting point for someone who wants to start
        out retro-programming for the DOS platform.
      </p>
      <p>
        This list is{" "}
        <a
          href="https://twitter.com/awesome__re/status/1355813614469271555"
          target="_blank"
          rel="noreferrer"
        >
          featured
        </a>{" "}
         on the official{" "}
        <a
          href="https://github.com/sindresorhus/awesome"
          target="_blanK"
          rel="noreferrer"
        >
          Awesome collection
        </a>{" "}
         made by Sindre Sorhus.
      </p>
    </SideProjectCard>
  </div>
</ResumeSection>
