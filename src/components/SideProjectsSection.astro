---
import { getCollection } from 'astro:content';
import ResumeSection from "./ResumeSection.astro";
import SideProjectCard from "./SideProjectCard.astro";

const projects = await getCollection('side-projects');
---

<ResumeSection id="projects" title="Check out my projects">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {projects.map(({ data: p }) => (
      <SideProjectCard
        title={p.title}
        repoUrl={p.repoUrl}
        demoUrl={p.demoUrl}
        domain={p.domain}
        badges={p.badges}
        image={p.image}
        githubStarRepo={p.githubStarRepo}
        description={p.description}
      />
    ))}
  </div>
</ResumeSection>
