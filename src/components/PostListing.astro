---
const allPosts = Object.values(import.meta.glob('../pages/blog/*.md', { eager: true }));
---

<ul class="w-full text-left">
  {allPosts.map((post: any) => <li class="flex flex-col mb-2">
    <a
      class="text-xl underline text-[rgb(122,113,113)] link-hover"
      href={post.url}>
      {post.frontmatter.title}
    </a>
    <p class="text-gray-600">{post.frontmatter.summary}</p>
  </li>)}
</ul>
